# Скопируйте этот файл в .env и подставьте свои значения.
# .env в git не попадёт — он в .gitignore.

# Пароль от личного кабинета.
# ⚠️ ЭТО НЕ ЗАЩИТА: Vite подставляет VITE_-переменные прямо в бандл, пароль
# видно в исходниках страницы. Годится только чтобы кабинет не открывался
# случайному посетителю. Подробности — в README, раздел «Логин: почему это не защита».
VITE_ADMIN_PASSWORD=

# Куда улетает заявка с формы на витрине (n8n webhook, если поднят).
# Публичный URL — не секрет, но с этого адреса нужно принимать POST JSON
# {name, contact, task}. Необязательно.
VITE_LEAD_WEBHOOK_URL=

# Formspree — дублирующее уведомление на почту (необязательно, параллельно
# с основным приёмом через Supabase ниже). Формат тот же POST JSON.
VITE_LEAD_FORMSPREE_URL=https://formspree.io/f/mbgjewzl

# Supabase — основной приём заявок, чтобы они появлялись в /dashboard.
# URL и anon-ключ берутся в Supabase → Project Settings → API.
# anon-ключ — публичный по дизайну Supabase (уйдёт в бандл), доступ к данным
# держится на RLS-политиках таблицы, не на секретности ключа.
# Без этих двух переменных заявки видны только в localStorage — см. README.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Адрес серверного прокси для Instagram Graph API (метрики профиля).
# Пока пусто — панель честно показывает «не подключено».
# Токен Meta сюда класть НЕЛЬЗЯ: он попадёт в бандл и станет публичным.
# Токен живёт только на сервере, фронт ходит на этот прокси.
VITE_INSTAGRAM_PROXY_URL=
